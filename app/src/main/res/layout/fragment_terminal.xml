<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080c14">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Hero -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#0d1424"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Terminal Interactif"
                    android:textColor="#00d4ff"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sandbox PHP"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Écrivez et testez votre code PHP directement dans l'application."
                    android:textColor="#64748b"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.4"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Challenges -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Défis pratiques"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/challengesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <!-- PHP Editor -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Éditeur PHP"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#020408"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Terminal Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="#0d1424">

                    <View android:layout_width="10dp" android:layout_height="10dp"
                        android:background="@drawable/dot_red" android:layout_marginEnd="6dp" />
                    <View android:layout_width="10dp" android:layout_height="10dp"
                        android:background="@drawable/dot_yellow" android:layout_marginEnd="6dp" />
                    <View android:layout_width="10dp" android:layout_height="10dp"
                        android:background="@drawable/dot_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHP 8.3 — SDS LABS SANDBOX"
                        android:textColor="#64748b"
                        android:textSize="11sp"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1e2d45" />

                <!-- Code Editor -->
                <EditText
                    android:id="@+id/etPhpEditor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="200dp"
                    android:background="@null"
                    android:padding="16dp"
                    android:textColor="#e2e8f0"
                    android:textColorHint="#64748b"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:gravity="top"
                    android:scrollbars="vertical" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1e2d45" />

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="start">

                    <Button
                        android:id="@+id/btnRun"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="▶ Exécuter"
                        android:backgroundTint="#0A1F2E"
                        android:textColor="#00d4ff"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <Button
                        android:id="@+id/btnClear"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="✕ Effacer"
                        android:backgroundTint="#0A1F2E"
                        android:textColor="#64748b"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Output Terminal -->
        <androidx.cardview.widget.CardView
            android:id="@+id/outputCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:visibility="gone"
            app:cardBackgroundColor="#020408"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="#0d1424">

                    <View android:layout_width="10dp" android:layout_height="10dp"
                        android:background="@drawable/dot_red" android:layout_marginEnd="6dp" />
                    <View android:layout_width="10dp" android:layout_height="10dp"
                        android:background="@drawable/dot_yellow" android:layout_marginEnd="6dp" />
                    <View android:layout_width="10dp" android:layout_height="10dp"
                        android:background="@drawable/dot_green" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OUTPUT"
                        android:textColor="#64748b"
                        android:textSize="11sp"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1e2d45" />

                <TextView
                    android:id="@+id/tvOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="80dp"
                    android:padding="16dp"
                    android:textColor="#94a3b8"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:lineSpacingMultiplier="1.6" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
